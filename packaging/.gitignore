# Локальные артефакты сборки (родительский .gitignore их тоже прячет;
# здесь — чтобы правила жили рядом со сборкой).

# окружение сборки и её выходы
.build-venv/
build/
dist/
build-ui/
build-ui-linux/

# отладочная (консольная) сборка: FOREST_CONSOLE_BUILD=1
build-console/
dist-console/

# скачанное официальное ядро Xray-core: НЕ коммитим бинарники (~63 МиБ),
# его детерминированно качает `python fetch_core.py` (пин — core.lock.json)
vendor/

# то же для Linux-сборки: ядро Xray-linux-64 (~63 МиБ) качает
# `python3 fetch_core_linux.py` (пин — core.lock.linux.json)
vendor-linux/
.build-venv-linux/
build-linux/

# предпросмотры иконки
icon_preview_*.png

# кэш pip (чтобы не рос диск на C: при сборке помощника на Qt)
.pipecache/

# ВАЖНО: спеку и скрипты сборки держим в репозитории — отменяем
# родительский `*.spec`, иначе спецификация выпадет из git.
!ForestProxyUpdater.spec
!*.spec
